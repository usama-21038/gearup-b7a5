# Base URL of the GearUp backend API (include the trailing /api).
# Defaults to the deployed backend from the assignment brief if unset.
NEXT_PUBLIC_API_BASE_URL=https://gearup-b7a4-1.onrender.com/api

# Stripe publishable key (starts with pk_test_ or pk_live_).
# Required for the Stripe Elements card form under
# /dashboard/customer/orders/[id]/pay to render. Get one from
# https://dashboard.stripe.com/test/apikeys — it MUST be the same Stripe
# account whose secret key (sk_test_...) is set as STRIPE_SECRET_KEY on the
# backend, or PaymentIntents created by the backend won't be confirmable here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
